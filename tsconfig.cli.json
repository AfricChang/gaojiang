{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-cli",
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "scripts/mermaid-export.ts",
    "scripts/pdf-export.ts",
    "src/lib/headless/mermaidCli.ts",
    "src/lib/headless/mermaidExport.ts",
    "src/lib/headless/mermaidExtractor.ts",
    "src/lib/headless/mermaidRenderer.ts",
    "src/lib/headless/mermaidWriter.ts"
  ]
}
